<!DOCTYPE html>
<html data-theme="forest">
<head>
  <title><%= content_for(:title) || "ReadLink" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <link rel="manifest" href="pwa/manifest.json">
  <link rel="icon" href="/favicon.ico">
  <link rel="icon" type="image/png" sizes="16x16" href="/icon/favicon-16x16.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/icon/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="48x48" href="/icon/favicon-48x48.png">
  <link rel="icon" type="image/png" sizes="48x48" href="/icon/favicon-96x96.png">
  <link rel="icon" type="image/svg+xml" href="/img/icon/favicon.svg">
  <link rel="apple-touch-icon" sizes="180x180" href="/img/icon/apple-touch-icon.png">
  <link rel="mask-icon" color="#ffffff" href="/img/icon/favicon.svg">
  <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.3.0/dist/leaflet.css">
  <script src="https://unpkg.com/leaflet@1.3.0/dist/leaflet.js"></script>
</head>

<body class="d-flex flex-column min-vh-100">
    <header class="bg-white shadow-md">
      <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
          <div class="flex items-center">
            <a class="text-2xl font-bold text-green-600 hover:text-green-700" href="/">ReadLink</a>
          </div>
          
          <div class="hidden sm:flex sm:items-center sm:space-x-4">
            <%= link_to "全国の図書館", regions_path, class: "text-gray-700 hover:text-green-600 px-3 py-2 rounded-md text-sm font-medium" %>

            <% if user_signed_in? %>
              <%= link_to "図書館設定", library_settings_path, class: "text-gray-700 hover:text-green-600 px-3 py-2 rounded-md text-sm font-medium" %>
              
              <div class="relative group">
                <button class="text-gray-700 hover:text-green-600 px-3 py-2 rounded-md text-sm font-medium">
                  読書管理
                </button>
                <div class="absolute right-0 w-48 py-2 mt-2 bg-white rounded-md shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50">
                  <%= link_to "読みたい本", want_to_read_books_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-green-50" %>
                  <%= link_to "読んだ本", already_read_books_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-green-50" %>
                </div>
              </div>
              
              <%= link_to "ログアウト", destroy_user_session_path, method: :delete, class: "bg-red-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-red-700" %>
            <% else %>
              <%= link_to "ログイン", new_user_session_path, class: "bg-green-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-green-700" %>
              <%= link_to '新規登録', new_user_registration_path, class: "bg-blue-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-blue-700" %>
            <% end %>
          </div>
        </div>
      </nav>
    </header>

  
    <% flash.each do |type, message| %>
      <div class="alert alert-<%= type == 'notice' ? 'success' : 'danger' %>">
        <%= message %>
      </div>
    <% end %>

    <div class="relative w-full">
  <div class="<%= (controller_name == 'homes' && action_name == 'top') ? 'min-h-screen' : 'h-auto' %>">
    <% if (controller_name == 'homes' && action_name == 'top') || (controller_name == 'sessions') || (controller_name == 'registrations') %>
      <img src="<%= asset_path('portfolio.png') %>" alt="ポートフォリオ用の画像" class="absolute inset-0 object-cover w-full h-full" style="object-position: bottom;" />


    <% end %>

    <%= form_with url: search_books_path, local: true, method: :get do |f| %>
      <div class="absolute top-5 right-0 w-full max-w-md p-4 flex justify-end">
        <div class="relative w-full max-w-md">
          <%= f.search_field :search_term, class: "form-control w-full p-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500", placeholder: "本のタイトルや著者名を入力" %>
          <%= f.submit "検索", class: "btn btn-primary bg-blue-500 text-white rounded-lg px-4 py-2 hover:bg-blue-600 transition" %>
        </div>
      </div>
    <% end %>
  </div>
</div>


      <!-- 画像の上に他のコンテンツを配置 -->
    <div class="flex-grow-1 d-flex flex-column"> 
      <div class="content w-full p-4 mt-4">
        <%= yield %>
      </div>
    </div>
  
  
    <footer class="bg-gray-800 text-white mt-auto">
      <div class="max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
        <nav class="flex flex-wrap justify-center space-x-6">
          <a href="#" class="text-gray-300 hover:text-white transition duration-150 ease-in-out">お問い合わせ</a>
          <a href="#" class="text-gray-300 hover:text-white transition duration-150 ease-in-out">利用規約</a>
          <a href="#" class="text-gray-300 hover:text-white transition duration-150 ease-in-out">プライバシーポリシー</a>
        </nav>
        <p class="mt-8 text-center text-gray-400 text-sm">
          &copy; <%= Time.current.year %> ReadLink. All rights reserved.
        </p>
      </div>
    </footer>
  

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
