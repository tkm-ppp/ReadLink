<!DOCTYPE html>
<html data-theme="light">
<head>
  <title><%= content_for(:title) || "ReadLink" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <link rel="manifest" href="pwa/manifest.json">
  <link rel="icon" href="/favicon.ico">
  <link rel="icon" type="image/png" sizes="16x16" href="/icon/favicon-16x16.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/icon/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="48x48" href="/icon/favicon-48x48.png">
  <link rel="icon" type="image/png" sizes="48x48" href="/icon/favicon-96x96.png">
  <link rel="icon" type="image/svg+xml" href="/img/icon/favicon.svg">
  <link rel="apple-touch-icon" sizes="180x180" href="/img/icon/apple-touch-icon.png">
  <link rel="mask-icon" color="#ffffff" href="/img/icon/favicon.svg">
  <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.3.0/dist/leaflet.css">
  <script src="https://unpkg.com/leaflet@1.3.0/dist/leaflet.js"></script>
</head>

<body class="flex flex-col min-h-screen bg-stone-50">
    <header class="bg-amber-800 shadow-md">
      <nav class="container mx-auto px-4">
        <div class="flex items-center justify-between h-16">
          <a class="text-2xl font-serif text-white hover:text-amber-100 transition" href="/">ReadLink</a>
          
          <div class="flex items-center space-x-4">
            <div class="flex items-center space-x-4">
              <%= link_to "全国の図書館", regions_path, class: "text-white hover:text-amber-100 px-3 py-2 rounded-lg transition" %>

              <% if user_signed_in? %>
                <%= link_to "図書館設定", library_settings_path, class: "text-white hover:text-amber-100 px-3 py-2 rounded-lg transition" %>
                
                <div class="relative group">
                  <button class="text-white hover:text-amber-100 px-3 py-2 rounded-lg transition">読書管理</button>
                  <ul class="absolute hidden right-0 w-48 bg-white shadow-lg rounded-lg mt-2 py-2 group-hover:block z-10">
                    <li><%= link_to "読みたい本", want_to_read_books_path, class: "block px-4 py-2 text-gray-700 hover:bg-amber-50 transition" %></li>
                    <li><%= link_to "読んだ本", already_read_books_path, class: "block px-4 py-2 text-gray-700 hover:bg-amber-50 transition" %></li>
                  </ul>
                </div>
                
                <%= link_to "ログアウト", destroy_user_session_path, method: :delete, class: "bg-amber-900 text-white px-4 py-2 rounded-lg hover:bg-amber-950 transition" %>
              <% else %>
                <%= link_to "ログイン", new_user_session_path, class: "bg-amber-900 text-white px-4 py-2 rounded-lg hover:bg-amber-950 transition" %>
                <%= link_to '新規登録', new_user_registration_path, class: "bg-amber-900 text-white px-4 py-2 rounded-lg hover:bg-amber-950 transition" %>
              <% end %>
            </div>
          </div>
        </div>
      </nav>
    </header>

  
    <% flash.each do |type, message| %>
      <div class="alert alert-<%= type == 'notice' ? 'success' : 'danger' %>">
        <%= message %>
      </div>
    <% end %>

    <div class="relative w-full">
  <div class="<%= (controller_name == 'homes' && action_name == 'top') ? 'min-h-screen' : 'h-auto' %>">
    <% if (controller_name == 'homes' && action_name == 'top') || (controller_name == 'sessions') || (controller_name == 'registrations') %>
      <img src="<%= asset_path('portfolio.png') %>" alt="ポートフォリオ用の画像" class="absolute inset-0 object-cover w-full h-full" style="object-position: bottom;" />


    <% end %>

    <%= form_with url: search_books_path, local: true, method: :get do |f| %>
      <div class="absolute top-5 right-0 w-full max-w-md p-4 flex justify-end">
        <div class="relative w-full max-w-md">
          <%= f.search_field :search_term, class: "form-control w-full p-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500", placeholder: "本のタイトルや著者名を入力" %>
          <%= f.submit "検索", class: "btn btn-primary bg-blue-500 text-white rounded-lg px-4 py-2 hover:bg-blue-600 transition" %>
        </div>
      </div>
    <% end %>
  </div>
</div>


      <!-- 画像の上に他のコンテンツを配置 -->
    <div class="flex-grow-1 d-flex flex-column"> 
      <div class="content w-full p-4 mt-4">
        <%= yield %>
      </div>
    </div>
  
  
    <footer class="bg-amber-800 text-white mt-auto">
      <div class="container mx-auto px-4 py-8">
        <div class="flex flex-col md:flex-row justify-between items-center">
          <div class="mb-4 md:mb-0">
            <h3 class="text-xl font-serif mb-2">ReadLink</h3>
            <p class="text-amber-100">あなたの読書生活をサポート</p>
          </div>
          
          <nav class="flex space-x-8">
            <div>
              <h4 class="font-medium mb-2">サービス</h4>
              <ul class="space-y-2">
                <li><a href="#" class="text-amber-100 hover:text-white transition">図書館を探す</a></li>
                <li><a href="#" class="text-amber-100 hover:text-white transition">本を探す</a></li>
              </ul>
            </div>
            
            <div>
              <h4 class="font-medium mb-2">サポート</h4>
              <ul class="space-y-2">
                <li><a href="#" class="text-amber-100 hover:text-white transition">お問い合わせ</a></li>
                <li><a href="#" class="text-amber-100 hover:text-white transition">利用規約</a></li>
                <li><a href="#" class="text-amber-100 hover:text-white transition">プライバシーポリシー</a></li>
              </ul>
            </div>
          </nav>
        </div>
        
        <div class="mt-8 pt-4 border-t border-amber-700 text-center text-amber-100">
          <p>&copy; <%= Time.current.year %> ReadLink. All rights reserved.</p>
        </div>
      </div>
    </footer>
  

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
